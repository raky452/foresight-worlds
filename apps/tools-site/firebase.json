{
  "hosting": {
    "public": "public",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*"
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          }
        ]
      }
    ],
    "predeploy": [
      "python3 \"$PROJECT_DIR/build.py\""
    ],
    "redirects": [
      {
        "source": "/compress-image-to-20kb",
        "destination": "/converters/compress-image-to-20kb",
        "type": 301
      },
      {
        "source": "/compress-image-to-50kb",
        "destination": "/converters/compress-image-to-50kb",
        "type": 301
      },
      {
        "source": "/exam-photo-signature-resizer",
        "destination": "/converters/exam-photo-signature-resizer",
        "type": 301
      },
      {
        "source": "/passport-photo-sheet",
        "destination": "/converters/passport-photo-sheet",
        "type": 301
      },
      {
        "source": "/compress-pdf-to-100kb",
        "destination": "/converters/compress-pdf-to-100kb",
        "type": 301
      },
      {
        "source": "/heic-to-jpg",
        "destination": "/converters/heic-to-jpg",
        "type": 301
      },
      {
        "source": "/heic-to-png",
        "destination": "/converters/heic-to-png",
        "type": 301
      },
      {
        "source": "/webp-to-png",
        "destination": "/converters/webp-to-png",
        "type": 301
      },
      {
        "source": "/webp-to-jpg",
        "destination": "/converters/webp-to-jpg",
        "type": 301
      },
      {
        "source": "/avif-to-jpg",
        "destination": "/converters/avif-to-jpg",
        "type": 301
      },
      {
        "source": "/png-to-jpg",
        "destination": "/converters/png-to-jpg",
        "type": 301
      },
      {
        "source": "/jpg-to-png",
        "destination": "/converters/jpg-to-png",
        "type": 301
      },
      {
        "source": "/compress-image",
        "destination": "/converters/compress-image",
        "type": 301
      },
      {
        "source": "/compress-image-to-100kb",
        "destination": "/converters/compress-image-to-100kb",
        "type": 301
      },
      {
        "source": "/resize-image",
        "destination": "/converters/resize-image",
        "type": 301
      },
      {
        "source": "/jxl-to-jpg",
        "destination": "/converters/jxl-to-jpg",
        "type": 301
      },
      {
        "source": "/jxl-to-png",
        "destination": "/converters/jxl-to-png",
        "type": 301
      },
      {
        "source": "/open-jxl-file",
